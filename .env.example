# ============================================================
#  Social Media AI Agent — Environment Variables
#  Copy this file to .env and fill in your credentials
# ============================================================

# -----------------------------------------------------------
# Anthropic / Claude (REQUIRED)
# -----------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# -----------------------------------------------------------
# Brand Identity
# -----------------------------------------------------------
BRAND_NAME=Your Peptide Research Company
BRAND_VOICE=scientifically credible, educational, and research-focused — knowledgeable but accessible
BRAND_TOPICS=peptide research, biochemistry, compound mechanisms, peer-reviewed studies, lab science

# -----------------------------------------------------------
# Twitter / X
# Get credentials at: https://developer.twitter.com/
# -----------------------------------------------------------
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# -----------------------------------------------------------
# LinkedIn
# OAuth 2.0 access token from: https://www.linkedin.com/developers/
# -----------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# -----------------------------------------------------------
# Facebook Page
# From Meta Developer Portal: https://developers.facebook.com/
# -----------------------------------------------------------
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# -----------------------------------------------------------
# Instagram (Business Account via Meta Graph API)
# Same app as Facebook — needs instagram_content_publish permission
# -----------------------------------------------------------
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# -----------------------------------------------------------
# Bluesky
# Use an App Password from: https://bsky.app/settings/app-passwords
# -----------------------------------------------------------
BLUESKY_HANDLE=yourhandle.bsky.social
BLUESKY_APP_PASSWORD=

# -----------------------------------------------------------
# Database & Timezone
# -----------------------------------------------------------
DB_PATH=social_media.db
TIMEZONE=UTC
