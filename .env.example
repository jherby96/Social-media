# ============================================================
#  Peptide Ecommerce Automation Dashboard — Environment Variables
#  Copy this file to .env and fill in your credentials
# ============================================================

# -----------------------------------------------------------
# Anthropic / Claude (REQUIRED — powers AI content & support)
# -----------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6

# -----------------------------------------------------------
# Brand Identity
# -----------------------------------------------------------
BRAND_NAME=My Peptide Store
BRAND_VOICE=professional, scientific, and trustworthy
BRAND_TOPICS=peptide research, BPC-157, TB-500, Semaglutide, research-grade peptides

# -----------------------------------------------------------
# Business (Accounting & BAS)
# -----------------------------------------------------------
BUSINESS_NAME=My Peptide Store Pty Ltd
ABN=12 345 678 901
GST_RATE=0.10
BAS_PERIOD=quarterly
CURRENCY=AUD

# -----------------------------------------------------------
# WooCommerce (Tier 1 — Order Processing)
# Get API keys from: WooCommerce > Settings > Advanced > REST API
# Add webhook pointing to: https://yourdomain.com/api/webhooks/woocommerce
# -----------------------------------------------------------
WC_SITE_URL=https://yourstore.com
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_WEBHOOK_SECRET=your_webhook_secret_here

# -----------------------------------------------------------
# Email / SMTP (Tier 2 — Customer Communication)
# No Klaviyo or Mailchimp needed — uses your own SMTP server
# Gmail example: use an App Password (not your main password)
# -----------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASSWORD=your_app_password_here
FROM_EMAIL=orders@yourstore.com
FROM_NAME=My Peptide Store
SUPPORT_EMAIL=support@yourstore.com

# -----------------------------------------------------------
# Compliance (Tier 3 — COAs & Backups)
# COA files go in the coa_files/ directory
# Name format: SKU_LOTNUMBER.pdf  e.g.  BPC157-5MG_LOT2024A.pdf
# -----------------------------------------------------------
COA_DIRECTORY=coa_files
BACKUP_DIRECTORY=backups
BACKUP_INTERVAL_HOURS=24

# -----------------------------------------------------------
# Dashboard Web Server
# -----------------------------------------------------------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
DASHBOARD_SECRET_KEY=change-this-to-a-long-random-string
DASHBOARD_DEBUG=false

# -----------------------------------------------------------
# Database & Timezone
# -----------------------------------------------------------
DB_PATH=social_media.db
TIMEZONE=Australia/Sydney

# -----------------------------------------------------------
# Social Media Platforms (Tier 3 — Marketing)
# All optional — only configure what you use
# -----------------------------------------------------------

# Twitter / X — https://developer.twitter.com/
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# LinkedIn — https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# Facebook Page — https://developers.facebook.com/
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Instagram (Business Account via Meta Graph API)
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# Bluesky — https://bsky.app/settings/app-passwords
BLUESKY_HANDLE=yourhandle.bsky.social
BLUESKY_APP_PASSWORD=
